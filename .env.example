# 复制本文件为仓库根目录 .env.local，再填入本机值。
# .env.local 不提交。本文件只保留键名和可公开的默认值。
# 获取步骤见 AGENTS.md「本地环境变量」。不要使用 vercel env pull。

# 非 pooled。Drizzle migration 读 POSTGRES_URL_NON_POOLING。
# 知识库同步的 advisory lock 读 NITRO_SYNC_DATABASE_URL。两条使用同一条非 pooled 连接串。
# neon connection-string --project-id patient-cloud-43432277
POSTGRES_URL_NON_POOLING=
NITRO_SYNC_DATABASE_URL=

# pooled。检索、聊天和评估脚本读这一条。
# neon connection-string --project-id patient-cloud-43432277 --pooled
NITRO_DATABASE_URL=

# Worker 请求路径使用 Neon serverless。本地 Drizzle migration 与同步仍走 postgres.js。
NITRO_DATABASE_DRIVER=neon

# 模型名，不是密钥。现行向量维度按 bge-m3 的 1024 维。
NITRO_EMBEDDING_MODEL=@cf/baai/bge-m3

# Cloudflare 账号 ID 与 Workers AI token。token 从 Cloudflare 控制台复制，不能从 Worker 密钥回读。
NITRO_CLOUDFLARE_ACCOUNT_ID=
NITRO_CLOUDFLARE_API_TOKEN=

# 聊天供应商密钥。从对应控制台复制，不能从 GitHub Actions secrets 回读。
NITRO_ANTHROPIC_API_KEY=
NITRO_OPENAI_API_KEY=

# 自造密钥。丢失后重新生成，并同时写入 GitHub secrets 与 Worker。
NITRO_KNOWLEDGE_SYNC_TOKEN=
NITRO_CRON_SECRET=
