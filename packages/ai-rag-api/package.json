{
	"name": "@ruan-cat-drill-doc/ai-rag-api",
	"version": "0.0.0",
	"private": true,
	"homepage": "https://smallalice-docs-ai-nitro-api.ruan-cat.com/",
	"type": "module",
	"scripts": {
		"predev": "pnpm --filter @ruan-cat-drill-doc/ai-rag-core build",
		"dev": "nitro dev",
		"prebuild": "pnpm --filter @ruan-cat-drill-doc/ai-rag-core build",
		"build": "nitro build",
		"build:vercel": "pnpm --filter @ruan-cat-drill-doc/ai-rag-core build && nitro build --preset vercel && move-vercel-output-to-root --dereference",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"knowledge:prepare:dry-run": "tsx scripts/knowledge-prepare-dry-run.ts --dry-run",
		"embedding:diagnose": "tsx scripts/diagnose-cloudflare-embedding.ts",
		"embedding:model-smoke": "tsx scripts/run-embedding-model-smoke.ts",
		"rag:evaluate": "tsx scripts/run-rag-evaluation.ts",
		"rag:evaluate:promptfoo": "promptfoo eval -c promptfoo.yaml",
		"rag:sync": "tsx scripts/rag-sync.ts",
		"rag:watch": "tsx scripts/rag-watch.ts",
		"preview": "nitro preview",
		"test": "pnpm --filter @ruan-cat-drill-doc/ai-rag-core build && vitest run",
		"typecheck": "pnpm --filter @ruan-cat-drill-doc/ai-rag-core build && tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "1.2.12",
		"@ai-sdk/openai": "^1.3.22",
		"@ruan-cat-drill-doc/ai-rag-core": "workspace:*",
		"ai": "^4.3.16",
		"drizzle-orm": "^0.44.7",
		"nitro": "3.0.260610-beta",
		"postgres": "^3.4.7",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@ruan-cat/utils": "^4.26.0",
		"@types/node": "22.19.11",
		"drizzle-kit": "^0.31.4",
		"promptfoo": "0.122.2",
		"typescript": "5.9.3",
		"vitest": "2.1.9"
	}
}
