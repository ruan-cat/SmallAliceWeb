{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"target": "ES2022",
		"noEmit": true,
		"skipLibCheck": true,

		// === 2026-11-02 init-tsconfig 形态D（monorepo 子包）===
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
		"assumeChangesOnlyAffectDirectDependencies": true,
		"types": ["node"]
	},
	"include": ["scripts/**/*.ts", "server/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "nitro.config.ts"],
	"exclude": ["node_modules", "dist", ".output", "coverage"]
}
