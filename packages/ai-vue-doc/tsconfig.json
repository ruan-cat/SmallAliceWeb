{
	"extends": "./.nuxt/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,

		// === 2026-11-02 init-tsconfig 形态E（extends 外部 preset，本地覆盖即生效）===
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
		"assumeChangesOnlyAffectDirectDependencies": true
	},
	"vueCompilerOptions": {
		"strictTemplates": false
	},
	"include": [
		".nuxt/nuxt.d.ts",
		".nuxt/imports.d.ts",
		".nuxt/types/**/*.d.ts",
		".nuxt/schema/**/*.d.ts",
		"app.config.ts",
		"nuxt.config.ts",
		"pages/**/*.vue",
		"plugins/**/*.ts",
		"shims/**/*.ts",
		"types/**/*.d.ts",
		"workspace-aliases.ts"
	],
	"exclude": ["dist", ".output", "node_modules"]
}
