{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "small-alice-web-odse",
	// 本机 wrangler 4.131.1 的 workerd 只支持到 2026-09-18。
	"compatibility_date": "2026-09-18",
	"main": "./workers/docs-assets.ts",
	"assets": {
		"directory": "./docs/.vitepress/dist",
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/*",
			"!/assets/*",
			"!/*.html",
			"!/*.css",
			"!/*.js",
			"!/*.woff2",
			"!/*.svg",
			"!/*.png",
			"!/*.jpg",
			"!/*.jpeg",
			"!/*.gif",
			"!/*.webp",
			"!/*.ico",
		],
	},
}
