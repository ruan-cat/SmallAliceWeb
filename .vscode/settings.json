{
	// 针对picgo的配置 这里是指定上传图床类型 具体敏感配置存储在阮喵喵的个人全局配置内
	"picgo": {
		"picBed": {
			"current": "aliyun",
			"uploader": "aliyun"
		}
	},
	"files.eol": "\n",
	"files.associations": {
		".cursorignore": "ignore"
	},
	"explorer.fileNesting.enabled": true,
	// 2026-11-02 init-vscode：旧嵌套根 CLAUDE.md 已废弃，AGENTS.md 为单一事实源，CLAUDE.md/GEMINI.md 折叠为其索引引用
	"explorer.fileNesting.patterns": {
		"AGENTS.md": "CLAUDE.md,GEMINI.md"
	},
	"terminal.integrated.cwd": "${workspaceFolder}",
	"terminal.integrated.splitCwd": "workspaceRoot",
	// 2026-11-02 init-vscode：三层排除按模板同批补齐（files.exclude / search.exclude / files.watcherExclude）
	"files.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/dist-ssr": true,
		"**/build": true,
		"**/.next": true,
		"**/.nuxt": true,
		"**/.output": true,
		"**/.vite": true,
		"**/.vitepress/dist": true,
		"**/.vitepress/cache": true,
		"**/.vuepress/dist": true,
		"**/.vuepress/cache": true,
		"**/.turbo": true,
		"**/.vercel": true,
		"**/.cache": true,
		"**/.temp": true,
		"**/.tmp": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/.vitest-reporter-html": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs": true,
		"**/*.log": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/dist-ssr": true,
		"**/build": true,
		"**/.next": true,
		"**/.nuxt": true,
		"**/.output": true,
		"**/.vite": true,
		"**/.vitepress/dist": true,
		"**/.vitepress/cache": true,
		"**/.vuepress/dist": true,
		"**/.vuepress/cache": true,
		"**/.turbo": true,
		"**/.vercel": true,
		"**/.cache": true,
		"**/.temp": true,
		"**/.tmp": true,
		"**/cache": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/.vitest-reporter-html": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs": true,
		"**/*.log": true
	},
	"files.watcherExclude": {
		"**/.git/**": true,
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true,
		"**/.turbo/**": true,
		"**/.vercel/**": true,
		"**/dist/**": true,
		"**/dist-ssr/**": true,
		"**/build/**": true,
		"**/.next/**": true,
		"**/.nuxt/**": true,
		"**/.output/**": true,
		"**/.vite/**": true,
		"**/.vitepress/dist/**": true,
		"**/.vitepress/cache/**": true,
		"**/.vuepress/dist/**": true,
		"**/.vuepress/cache/**": true,
		"**/.cache/**": true,
		"**/.temp/**": true,
		"**/.tmp/**": true,
		"**/cache/**": true,
		"**/coverage/**": true,
		"**/.nyc_output/**": true,
		"**/.vitest-reporter-html/**": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs/**": true,
		"**/*.log": true,
		"**/.changeset/**": true
	},
	// 2026-11-02 init-vscode：TS 语言服务与搜索策略键（本仓为 pnpm 隔离结构，根目录无 node_modules/typescript，
	// 故 typescript.tsdk 有意不落地；typecheck 统一走 vue-tsc）
	"search.indexing.maxFileSize": 1048576,
	"typescript.tsserver.maxTsServerMemory": 4096,
	"typescript.disableAutomaticTypeAcquisition": true,
	"typescript.tsserver.watchOptions": {
		"watchFile": "useFsEvents",
		"watchDirectory": "useFsEvents",
		"fallbackPolling": "dynamicPriority"
	},
	"code-runner.executorMap": {
		"typescript": "pnpm dotenvx run -- tsx $fullFileName"
	},
	"vue.server.includeLanguages": ["vue"],
	"iconify.annotations": true,
	"iconify.inplace": true
}
